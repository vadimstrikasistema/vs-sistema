rules_version = '2';

// Reglas de seguridad del sistema Vadim Strika.
// Se copian en Firebase → Firestore Database → Reglas → Publicar.
//
// 1. Solo entran los correos de la lista (los mismos de js/config.js).
// 2. Nada se borra: ninguna colección permite eliminar documentos.
//    Lo que deja de usarse se archiva, se oculta o se anula desde la app.

service cloud.firestore {
  match /databases/{database}/documents {

    function permitido() {
      return request.auth != null
        && request.auth.token.email.lower() in [
          'megustalacomidadelosaviones@gmail.com',
          'vadimstrikasistema@gmail.com'
        ];
    }

    // Toda escritura debe dejar registro de quién la hizo.
    function firmado() {
      return request.resource.data.actualizadoPor == request.auth.token.email;
    }

    // Configuración: empresa, costeo y versión del sistema.
    match /config/{docId} {
      allow read: if permitido();
      allow create, update: if permitido() && firmado()
        && docId in ['sistema', 'empresa', 'costeo', 'horno', 'ventas'];
      allow delete: if false;
    }

    // Listas editables: siempre deben conservar su arreglo de ítems.
    match /listas/{clave} {
      allow read: if permitido();
      allow create, update: if permitido() && firmado()
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 300;
      allow delete: if false;
    }

    // Insumos y recetas: se crean y editan; lo que deja de usarse se archiva.
    match /insumos/{id} {
      allow read: if permitido();
      allow create, update: if permitido() && firmado()
        && request.resource.data.nombre is string
        && request.resource.data.unidad is string;
      allow delete: if false;
    }
    match /recetas/{id} {
      allow read: if permitido();
      allow create, update: if permitido() && firmado()
        && request.resource.data.ingredientes is list;
      allow delete: if false;
    }

    // Movimientos de stock: una vez creados no se modifican.
    // Lo único que se permite después es marcarlos como anulados.
    match /movimientos/{id} {
      allow read: if permitido();
      allow create: if permitido() && firmado()
        && request.resource.data.cantidad is number
        && request.resource.data.insumoId is string
        && request.resource.data.anulado == false;
      allow update: if permitido() && firmado()
        && resource.data.anulado == false
        && request.resource.data.anulado == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['anulado', 'anuladoEn', 'anulacionId', 'actualizado', 'actualizadoPor']);
      allow delete: if false;
    }

    // Preparaciones de recetas: igual que los movimientos, solo se anulan.
    match /preparaciones/{id} {
      allow read: if permitido();
      allow create: if permitido() && firmado() && request.resource.data.anulado == false;
      allow update: if permitido() && firmado()
        && resource.data.anulado == false
        && request.resource.data.anulado == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['anulado', 'anuladoEn', 'actualizado', 'actualizadoPor']);
      allow delete: if false;
    }

    // Conteos físicos: registro histórico, no se modifican.
    match /conteos/{id} {
      allow read: if permitido();
      allow create: if permitido() && firmado();
      allow update, delete: if false;
    }

    // Gastos: se editan (clasificar, pagar) y se anulan; nunca se borran.
    match /gastos/{id} {
      allow read: if permitido();
      allow create, update: if permitido() && firmado()
        && request.resource.data.lineas is list
        && request.resource.data.tipoDoc is number;
      allow delete: if false;
    }

    // Proveedores: datos y lo aprendido de sus facturas, por RUT.
    match /proveedores/{rut} {
      allow read: if permitido();
      allow create, update: if permitido() && firmado();
      allow delete: if false;
    }

    // Alertas de precio: se crean al clasificar; después solo se marcan como vistas.
    match /alertasPrecio/{id} {
      allow read: if permitido();
      allow create: if permitido() && firmado();
      allow update: if permitido() && firmado()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['visto', 'actualizado', 'actualizadoPor']);
      allow delete: if false;
    }

    // Fichas de pieza (con su stock de terminadas) y lotes: se editan y se archivan o anulan.
    match /piezas/{id} {
      allow read: if permitido();
      allow create, update: if permitido() && firmado() && request.resource.data.nombre is string;
      allow delete: if false;
    }
    match /lotes/{id} {
      allow read: if permitido();
      allow create, update: if permitido() && firmado() && request.resource.data.piezaId is string;
      allow delete: if false;
    }

    // Quemas: registro histórico, no se modifican.
    match /quemas/{id} {
      allow read: if permitido();
      allow create: if permitido() && firmado() && request.resource.data.lotes is list;
      allow update, delete: if false;
    }

    // Movimientos de piezas terminadas: igual que los de insumos, solo se anulan.
    match /movPiezas/{id} {
      allow read: if permitido();
      allow create: if permitido() && firmado()
        && request.resource.data.cantidad is number
        && request.resource.data.piezaId is string
        && request.resource.data.anulado == false;
      allow update: if permitido() && firmado()
        && resource.data.anulado == false
        && request.resource.data.anulado == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['anulado', 'anuladoEn', 'anulacionId', 'actualizado', 'actualizadoPor']);
      allow delete: if false;
    }

    // Clientes: se editan y se archivan.
    match /clientes/{id} {
      allow read: if permitido();
      allow create, update: if permitido() && firmado() && request.resource.data.tipo in ['empresa', 'persona'];
      allow delete: if false;
    }

    // Facturas emitidas (cuentas por cobrar): se registran pagos y se anulan; nunca se borran.
    match /facturas/{id} {
      allow read: if permitido();
      allow create, update: if permitido() && firmado()
        && request.resource.data.total is number
        && request.resource.data.clienteId is string;
      allow delete: if false;
    }

    // Pagos recibidos: una vez creados solo se pueden anular.
    match /pagos/{id} {
      allow read: if permitido();
      allow create: if permitido() && firmado() && request.resource.data.monto is number && request.resource.data.anulado == false;
      allow update: if permitido() && firmado()
        && resource.data.anulado == false
        && request.resource.data.anulado == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['anulado', 'motivoAnulacion', 'anuladoEn', 'actualizado', 'actualizadoPor']);
      allow delete: if false;
    }

    // Ventas directas: no se modifican; solo se anota la boleta, el cliente o se anulan.
    match /ventas/{id} {
      allow read: if permitido();
      allow create: if permitido() && firmado()
        && request.resource.data.lineas is list
        && request.resource.data.total is number
        && request.resource.data.anulado == false;
      allow update: if permitido() && firmado()
        && resource.data.anulado == false
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['boleta', 'clienteId', 'clienteNombre', 'anulado', 'motivoAnulacion', 'anuladoEn', 'actualizado', 'actualizadoPor']);
      allow delete: if false;
    }

    // Ferias: se editan y se cierran.
    match /ferias/{id} {
      allow read: if permitido();
      allow create, update: if permitido() && firmado() && request.resource.data.nombre is string;
      allow delete: if false;
    }

    // Órdenes de venta a empresas: cambian de estado (entregada, facturada,
    // anulada) pero nunca se borran.
    match /ordenes/{id} {
      allow read: if permitido();
      allow create, update: if permitido() && firmado()
        && request.resource.data.numero is number
        && request.resource.data.clienteId is string
        && request.resource.data.lineas is list
        && request.resource.data.total is number;
      allow delete: if false;
    }

    // Consignaciones: se agregan piezas, se liquidan, se cierran o anulan; nunca se borran.
    match /consignaciones/{id} {
      allow read: if permitido();
      allow create, update: if permitido() && firmado()
        && request.resource.data.numero is number
        && request.resource.data.clienteId is string
        && request.resource.data.lineas is list;
      allow delete: if false;
    }

    // Colecciones de las fases siguientes (insumos, piezas, ventas, gastos…).
    // Se leen y escriben solo con permiso; nunca se borran.
    // (Excluye las colecciones de arriba para no saltarse sus reglas:
    // en Firestore basta que una regla permita para que se permita.)
    match /{coleccion}/{docId} {
      allow read: if permitido();
      allow create, update: if permitido() && !(coleccion in ['config', 'listas', 'insumos', 'recetas', 'movimientos', 'preparaciones', 'conteos', 'gastos', 'proveedores', 'alertasPrecio', 'piezas', 'lotes', 'quemas', 'movPiezas', 'clientes', 'facturas', 'pagos', 'ventas', 'ferias', 'ordenes', 'consignaciones']);
      allow delete: if false;
    }
  }
}
